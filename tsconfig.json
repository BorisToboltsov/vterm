{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true
  },
  // `$app/tsconfig` (written by `svelte-kit sync` into node_modules) carries the
  // essential and recommended options — module resolution, `allowJs`/`checkJs`,
  // `verbatimModuleSyntax`, `allowImportingTsExtensions` — but no include/exclude:
  // TypeScript does not merge those, so the project names its own (the same set
  // SvelteKit 2 generated: the app sources and the Vite config).
  "include": ["src", "vite.config.js"],
  "exclude": ["node_modules"]
}
